generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  recipeId  Int      @map("recipe_id")
  title     String
  image     String?
  cookTime  String?  @map("cook_time")
  servings  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("favorites")
}

model AiRecipe {
  id            Int      @id @default(autoincrement())
  userId        String   @map("user_id")
  recipeName    String   @map("recipe_name")
  ingredients   Json
  instructions  Json
  imageData     String?  @map("image_data")
  imageMimeType String?  @map("image_mime_type") @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("ai_recipes")
}
