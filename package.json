{
	"name": "repo",
	"version": "1.0.0",
	"description": "Recipe app monorepo workspace",
	"private": true,
	"packageManager": "bun@1.2.19",
	"scripts": {
		"dev": "bun --filter='*' dev",
		"build": "bun --filter='*' build",
		"start": "bun --filter='*' start",
		"test": "bun --filter='*' test",
		"lint": "bun --filter='*' lint",
		"clean": "bun --filter='*' clean",
		"dev:api": "bun --filter=api dev",
		"dev:mobile": "bun --filter=mobile dev",
		"install:all": "bun install"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"keywords": [
		"recipe",
		"monorepo",
		"workspace"
	],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"workspace-version-aligner": "^1.0.1"
	}
}
